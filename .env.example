# .env.example

# Binance API Key
# Replace 'your_binance_api_key' with your actual Binance API key
BINANCE_API_KEY=your_binance_api_key

# Binance Secret Key
# Replace 'your_binance_secret_key' with your actual Binance secret key
BINANCE_SECRET_KEY=your_binance_secret_key

# OpenAI API Key
# Replace 'your_openai_api_key' with your actual OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Paper Trading Mode
# Set to 'true' to enable paper trading mode, or 'false' for live trading
PAPER_TRADING=true
